API_BASE_URL=https://api-demo.opti-24.ru/vip/
API_KEY=your_api_key_here
API_LOGIN=your_login_here
API_PASSWORD=your_password_here
API_CONTRACT_ID=your_contract_id_here
API_REQUESTS_PER_SECOND=2
API_MAX_IN_FLIGHT=20
API_MAX_JSON_RESPONSE_BYTES=16777216
API_MAX_IN_MEMORY_RESPONSE_BYTES=67108864
